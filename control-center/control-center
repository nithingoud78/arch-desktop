    def _refresh_hotspot(self):
        def worker():
            try:
                # 1. Active state
                out = subprocess.check_output(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show", "--active"], stderr=subprocess.DEVNULL, timeout=2).decode()
                is_active = any(":wifi" in line and "hotspot" in line.lower() for line in out.splitlines())
                
                # 2. Existing profile settings
                ssid = "ArchHotspot"
                pwd = "archdesktop"
                try:
                    ssid = subprocess.check_output(["nmcli", "-g", "802-11-wireless.ssid", "connection", "show", "Hotspot"], stderr=subprocess.DEVNULL, timeout=2).decode().strip()
                    pwd = subprocess.check_output(["nmcli", "-s", "-g", "802-11-wireless-security.psk", "connection", "show", "Hotspot"], stderr=subprocess.DEVNULL, timeout=2).decode().strip()
                except Exception:
                    pass

                GLib.idle_add(self._update_hotspot_ui, is_active, ssid, pwd)
            except Exception:
                GLib.idle_add(self._update_hotspot_ui, False, "ArchHotspot", "archdesktop")

        threading.Thread(target=worker, daemon=True).start()

    def _update_hotspot_ui(self, is_active, ssid, pwd):
        if getattr(self, "is_destroyed", False):
            return False

        if is_active:
            self.lbl_hs_sub.set_text("Active  •  Sharing Wi-Fi")
            self.btn_hs_toggle.set_label("ON")
            self.btn_hs_toggle.get_style_context().add_class("active")
        else:
            self.lbl_hs_sub.set_text("Inactive")
            self.btn_hs_toggle.set_label("OFF")
            self.btn_hs_toggle.get_style_context().remove_class("active")

        if ssid:
            self.entry_hs_ssid.set_text(ssid)
        if pwd:
            self.entry_hs_pwd.set_text(pwd)
        return False

    def _on_hotspot_power_switch_clicked(self, btn):
        turn_on = (btn.get_label() == "OFF")
        self._toggle_hotspot_power(turn_on)

    def _toggle_hotspot_power(self, turn_on):
        def worker():
            try:
                cmd = ["nmcli", "connection", "up", "Hotspot"] if turn_on else ["nmcli", "connection", "down", "Hotspot"]
                subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=8)
                time.sleep(0.4)
                GLib.idle_add(self._refresh_hotspot)
                if hasattr(self, "watcher"):
                    self.watcher.trigger()
            except Exception:
                pass
        threading.Thread(target=worker, daemon=True).start()

    def _save_hotspot_config(self):
        new_ssid = self.entry_hs_ssid.get_text().strip()
        new_pwd = self.entry_hs_pwd.get_text().strip()
        
        if not new_ssid:
            self.lbl_hs_feedback.set_text("SSID cannot be empty.")
            return
        if len(new_pwd) < 8:
            self.lbl_hs_feedback.set_text("Password must be at least 8 characters.")
            return

        self.lbl_hs_feedback.set_text("Saving configuration...")
        
        def worker():
            try:
                # Check if connection exists
                conns = subprocess.check_output(["nmcli", "-t", "-f", "NAME", "connection", "show"], stderr=subprocess.DEVNULL).decode()
                if "Hotspot" in conns.splitlines():
                    subprocess.run(["nmcli", "connection", "modify", "Hotspot", "802-11-wireless.ssid", new_ssid], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    subprocess.run(["nmcli", "connection", "modify", "Hotspot", "802-11-wireless-security.psk", new_pwd], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                else:
                    # Create hotspot connection
                    subprocess.run([
                        "nmcli", "connection", "add", "type", "wifi", "ifname", "*",
                        "con-name", "Hotspot", "autoconnect", "no", "ssid", new_ssid
                    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                    subprocess.run([
                        "nmcli", "connection", "modify", "Hotspot",
                        "802-11-wireless.mode", "ap",
                        "802-11-wireless-security.key-mgmt", "wpa-psk",
                        "802-11-wireless-security.psk", new_pwd,
                        "ipv4.method", "shared"
                    ], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

                # Check if currently active, reload if needed
                active_out = subprocess.check_output(["nmcli", "-t", "-f", "NAME", "connection", "show", "--active"], stderr=subprocess.DEVNULL).decode()
                if "Hotspot" in active_out.splitlines():
                    subprocess.run(["nmcli", "connection", "up", "Hotspot"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

                GLib.idle_add(lambda: self.lbl_hs_feedback.set_text("Settings saved successfully!"))
                time.sleep(0.4)
                GLib.idle_add(self._refresh_hotspot)
                if hasattr(self, "watcher"):
                    self.watcher.trigger()
            except Exception as e:
                GLib.idle_add(lambda: self.lbl_hs_feedback.set_text(f"Error: {str(e)}"))

        threading.Thread(target=worker, daemon=True).start()

