    def _pair_bluetooth(self, mac, name):
        """
        Interactive Bluetooth pairing session:
        Registers default agent, enables pairable mode, initiates pair, auto-confirms passkeys,
        trusts, and connects device.
        """
        self.lbl_bt_status.set_text(f"Pairing with {name}...")
        
        def worker():
            success = False
            msg = ""
            try:
                p = subprocess.Popen(
                    ["bluetoothctl"],
                    stdin=subprocess.PIPE,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.STDOUT,
                    text=True,
                    bufsize=1
                )
                
                # Send setup commands
                p.stdin.write("agent on\ndefault-agent\npairable on\n")
                p.stdin.write(f"pair {mac}\n")
                p.stdin.flush()
                
                start_t = time.time()
                while time.time() - start_t < 15:
                    line = p.stdout.readline()
                    if not line:
                        break
                    line_lower = line.lower()
                    if "confirm passkey" in line_lower or "(yes/no)" in line_lower or "authorize" in line_lower:
                        p.stdin.write("yes\n")
                        p.stdin.flush()
                    if "pairing successful" in line_lower:
                        success = True
                        break
                    if "failed to pair" in line_lower or "not available" in line_lower or "authenticationfailed" in line_lower:
                        msg = "Pairing failed. Device rejected request."
                        break

                if success:
                    p.stdin.write(f"trust {mac}\n")
                    p.stdin.write(f"connect {mac}\n")
                    p.stdin.write("quit\n")
                    p.stdin.flush()
                    p.wait(timeout=5)
                    msg = "Pairing successful!"
                else:
                    p.stdin.write("quit\n")
                    p.stdin.flush()
                    if not msg:
                        msg = "Pairing timed out."
            except Exception as e:
                msg = f"Error: {str(e)}"

            GLib.idle_add(lambda: self.lbl_bt_status.set_text(msg))
            time.sleep(1.0)
            GLib.idle_add(self._refresh_bluetooth)
            if hasattr(self, "watcher"):
                self.watcher.trigger()

        threading.Thread(target=worker, daemon=True).start()

