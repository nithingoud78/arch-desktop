    def _execute_power_action(self, btn):
        action = self.pending_power_action
        self._cancel_power_confirm(None)
        if hasattr(self, "daemon") and self.daemon:
            self.daemon.set_target_state("closed")
        self._close_with_animation()
        
        def run_action():
            time.sleep(0.2)
            if action == "shutdown":
                subprocess.run(["systemctl", "poweroff"])
            elif action == "reboot":
                subprocess.run(["systemctl", "reboot"])
            elif action == "hyprshut":
                subprocess.run(["systemctl", "suspend"])
        threading.Thread(target=run_action, daemon=True).start()

