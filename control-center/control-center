    def _sync_dock_size(self):
        if not getattr(self, "is_open", False):
            return True
        if hasattr(self, "stack") and self.stack.get_transition_running():
            return True
        current_size = get_dock_settings()
        if hasattr(self, "dock_size_btns"):
            for k, b in self.dock_size_btns.items():
                ctx = b.get_style_context()
                if k == current_size:
                    if not ctx.has_class("active"):
                        ctx.add_class("active")
                else:
                    if ctx.has_class("active"):
                        ctx.remove_class("active")
            if hasattr(self, "lbl_dock_desc"):
                prof = DOCK_PROFILES.get(current_size, DOCK_PROFILES["small"])
                self.lbl_dock_desc.set_text(f"Bottom & left docks: {prof['label']}")
        return True

