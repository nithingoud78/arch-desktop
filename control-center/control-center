    def _prompt_wifi_password(self, ssid):
        self.pending_wifi_ssid = ssid
        self.lbl_wifi_pwd_target.set_text(f"Join \"{ssid}\"")
        self.wifi_pwd_entry.set_text("")
        self.lbl_wifi_pwd_status.set_text("")
