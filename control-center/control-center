def send_daemon_cmd(cmd, timeout=0.6):
    if not os.path.exists(SOCK_PATH):
        return False
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(timeout)
        s.connect(SOCK_PATH)
        s.sendall((cmd + "\n").encode())
        resp = s.recv(128).decode("utf-8", errors="ignore").strip().lower()
        s.close()
        return resp in ("open", "closed", "ok")
    except Exception:
        return False

