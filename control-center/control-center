class ControlCenterDaemon:
    def __init__(self):
        self.window = None
        self.target_state = "closed"
        self._setup_signals()

    def _setup_signals(self):
        def sig_handler(signum, frame):
            if signum == signal.SIGUSR1:
                # Outside click dismissal
                if self.window:
                    GLib.idle_add(self.window._check_outside_click)
            elif signum == signal.SIGUSR2:
                # Escape key pressed
                if self.window:
                    GLib.idle_add(self.window._handle_escape)
            elif signum in (signal.SIGTERM, signal.SIGINT):
                self.quit()

        signal.signal(signal.SIGUSR1, sig_handler)
        signal.signal(signal.SIGUSR2, sig_handler)
        signal.signal(signal.SIGTERM, sig_handler)
        signal.signal(signal.SIGINT, sig_handler)

    def set_target_state(self, state):
        self.target_state = state

    def start_ipc_server(self):
        if os.path.exists(SOCK_PATH):
            try:
                os.unlink(SOCK_PATH)
            except Exception:
                pass

        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        server.bind(SOCK_PATH)
        server.listen(5)

        def sock_worker():
            while True:
                try:
                    conn, _ = server.accept()
                except Exception:
                    break
                try:
                    data = conn.recv(128).decode("utf-8", errors="ignore").strip()
                    if not data:
                        conn.close()
                        continue
                    parts = data.split()
                    cmd = parts[0].lower() if parts else ""
                    sub_arg = parts[1].lower() if len(parts) > 1 else None

                    target_action = None
                    if cmd == "open" or cmd in ("main", "wifi", "bluetooth", "hotspot", "settings", "power"):
                        self.target_state = "open"
                        resp = "open\n"
                        target_action = "open"
                    elif cmd == "close":
                        self.target_state = "closed"
                        resp = "closed\n"
                        target_action = "close"
                    elif cmd == "toggle":
                        if self.target_state == "open":
                            self.target_state = "closed"
                            resp = "closed\n"
                            target_action = "close"
                        else:
                            self.target_state = "open"
                            resp = "open\n"
                            target_action = "open"
                    elif cmd == "status":
                        resp = self.target_state + "\n"
                    else:
                        resp = "ok\n"

                    def handle_cmd(c=cmd, a=sub_arg, act=target_action):
                        if act == "close":
                            self.close()
                        elif act == "open":
                            if c in ("main", "wifi", "bluetooth", "hotspot", "settings"):
                                self.open(page=c)
                            elif c == "power":
                                self.open(show_power=True)
                            else:
                                self.open(page=a)

                    if target_action:
                        GLib.idle_add(handle_cmd)
                    
                    conn.sendall(resp.encode())
                except Exception:
                    pass
                finally:
                    try:
                        conn.close()
                    except Exception:
                        pass

        threading.Thread(target=sock_worker, daemon=True).start()

    def open(self, page=None, show_power=None):
        self.target_state = "open"
        set_arrow_state("open")
        if self.window is None:
            self.window = ControlCenter(daemon=self, initial_page=page or "main", show_power=show_power or False)
        self.window.animate_in(page=page, show_power=show_power)

    def close(self):
        self.target_state = "closed"
        set_arrow_state("closed")
        if self.window:
            self.window._close_with_animation()

    def toggle(self, page=None):
        if self.target_state == "open" and self.window and self.window.is_open:
            self.close()
        else:
            self.open(page=page)

    def run(self):
        self.start_ipc_server()
        try:
            with open(PID_FILE, "w") as f:
                f.write(str(os.getpid()))
        except Exception:
            pass

        # Create window pre-warmed but hidden for instantaneous 0ms display on first click
        self.window = ControlCenter(daemon=self, initial_page="main")
        self.window.hide()

        # Initial state: closed
        set_arrow_state("closed")

        try:
            Gtk.main()
        finally:
            self.quit()

    def quit(self):
        set_arrow_state("closed")
        if self.window:
            self.window.is_destroyed = True
            try:
                self.window._unbind_mouse()
            except Exception:
                pass
        try:
            if os.path.exists(PID_FILE):
                os.unlink(PID_FILE)
            if os.path.exists(SOCK_PATH):
                os.unlink(SOCK_PATH)
        except Exception:
            pass
        Gtk.main_quit()
        sys.exit(0)


def main():
    if len(sys.argv) > 1:
        cmd = sys.argv[1].lower()
        if cmd == "--daemon":
            daemon = ControlCenterDaemon()
            daemon.run()
            return
        elif cmd in ("open", "close", "toggle", "status", "main", "wifi", "bluetooth", "hotspot", "settings", "power"):
            arg = sys.argv[2] if len(sys.argv) > 2 else ""
            full_cmd = f"{cmd} {arg}".strip()
            if send_daemon_cmd(full_cmd):
                sys.exit(0)
            else:
                # If daemon not running, start it
                subprocess.Popen([sys.argv[0], "--daemon"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                time.sleep(0.3)
                send_daemon_cmd(full_cmd)
                sys.exit(0)
        elif cmd in ("-h", "--help"):
            print("Usage: control-center [open|close|toggle|main|wifi|bluetooth|hotspot|settings|power|status|--daemon]")
            sys.exit(0)

    # Default action: toggle
    if send_daemon_cmd("toggle"):
        sys.exit(0)
    else:
        subprocess.Popen([sys.argv[0], "--daemon"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        time.sleep(0.3)
        send_daemon_cmd("open")
        sys.exit(0)

if __name__ == "__main__":
    main()
