    def _set_media_artwork(self, art_path_or_url):
        pixbuf = None
        if art_path_or_url:
            path = art_path_or_url.replace("file://", "")
            if os.path.exists(path):
                try:
                    pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(path, 48, 48, False)
                except Exception:
                    pass
        if pixbuf is None:
            # Fallback to master wallpaper thumbnail
            wp = os.path.expanduser("~/Pictures/Wallpapers/master-wallpaper.jpg")
            if os.path.exists(wp):
                try:
                    pixbuf = GdkPixbuf.Pixbuf.new_from_file_at_scale(wp, 48, 48, False)
                except Exception:
                    pass
        if pixbuf:
            self.media_art_img.set_from_pixbuf(pixbuf)
        else:
            self.media_art_img.set_from_icon_name("audio-x-generic", Gtk.IconSize.DND)

