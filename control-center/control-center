    def _refresh_wifi(self, rescan=False):
        if getattr(self, "wifi_scanning", False):
            return
        self.wifi_scanning = True
        if hasattr(self, "btn_wifi_rescan"):
            self.btn_wifi_rescan.get_style_context().add_class("active")

        def worker():
            try:
                if rescan:
                    subprocess.run(["nmcli", "dev", "wifi", "rescan"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
                    time.sleep(0.8)
                
                # Fetch networks list
                cmd = ["nmcli", "-t", "-f", "ACTIVE,SSID,SIGNAL,SECURITY,BARS", "dev", "wifi", "list", "--rescan", "yes" if rescan else "auto"]
                out = subprocess.check_output(cmd, stderr=subprocess.DEVNULL, timeout=5).decode("utf-8", errors="ignore")
                
                # Saved connections for Forget button
                saved_out = subprocess.check_output(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show"], stderr=subprocess.DEVNULL, timeout=2).decode("utf-8", errors="ignore")
                saved_ssids = set()
                for line in saved_out.splitlines():
                    if ":802-11-wireless" in line or ":wifi" in line:
                        name = line.split(":")[0]
                        saved_ssids.add(name)

                active_net = None
                available_nets = []
                seen_ssids = set()

                for line in out.splitlines():
                    parts = line.split(":")
                    if len(parts) < 4:
                        continue
                    active = (parts[0] == "yes")
                    ssid = parts[1].replace("\\:", ":")
                    if not ssid or ssid == "--":
                        continue
                    try:
                        signal = int(parts[2])
                    except ValueError:
                        signal = 50
                    sec = parts[3]
                    is_secured = bool(sec and sec != "--")
                    
                    net_info = {
                        "ssid": ssid,
                        "signal": signal,
                        "secured": is_secured,
                        "saved": (ssid in saved_ssids),
                        "active": active
                    }

                    if active and not active_net:
                        active_net = net_info
                    elif ssid not in seen_ssids:
                        seen_ssids.add(ssid)
                        available_nets.append(net_info)

                available_nets.sort(key=lambda x: x["signal"], reverse=True)
                GLib.idle_add(self._update_wifi_ui, active_net, available_nets)
            except Exception:
                GLib.idle_add(self._update_wifi_ui, None, [])
            finally:
                self.wifi_scanning = False
                if hasattr(self, "btn_wifi_rescan"):
                    GLib.idle_add(lambda: self.btn_wifi_rescan.get_style_context().remove_class("active"))

        threading.Thread(target=worker, daemon=True).start()

    def _update_wifi_ui(self, active_net, available_nets):
        if getattr(self, "is_destroyed", False):
            return False

        # Clear active card
        for ch in self.wifi_active_card.get_children():
