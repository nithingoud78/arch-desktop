    def _on_brightness_change(self, scale):
        val = int(scale.get_value())
        self.lbl_bright_pct.set_text(f"{val}%")
        if self._bright_debounce_timer:
            GLib.source_remove(self._bright_debounce_timer)
        self._bright_debounce_timer = GLib.timeout_add(30, self._apply_brightness_async, val)

    def _apply_brightness_async(self, val):
        self._bright_debounce_timer = None
        def worker():
            try:
                subprocess.run(["brightnessctl", "s", f"{val}%"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except Exception:
                pass
        threading.Thread(target=worker, daemon=True).start()
