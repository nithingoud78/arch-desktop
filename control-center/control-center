    def _navigate_to(self, target_page):
        if not hasattr(self, "stack") or getattr(self, "is_closing", False) or getattr(self, "is_destroyed", False):
            return
        if hasattr(self, "_hide_wifi_password_box"):
            self._hide_wifi_password_box()
        if target_page == "wifi":
            self._refresh_wifi(rescan=False)
        elif target_page == "bluetooth":
            self._refresh_bluetooth()
        elif target_page == "hotspot":
            self._refresh_hotspot()
        elif target_page == "settings":
            self._sync_dock_size()
        elif target_page == "main":
            if hasattr(self, "watcher"):
                self.watcher.trigger()
        self.stack.navigate(target_page, instant=False)

