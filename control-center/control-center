    def _safe_mtime(self, path):
        try:
            return os.stat(os.path.expanduser(str(path))).st_mtime if path else 0
        except Exception:
            return 0

    def _poll_theme(self):
        if self._theme_checking or self.is_destroyed:
            return True
        self._theme_checking = True

        def worker():
            try:
                cur_pal = theme.load_palette()
                pal_wp = cur_pal.get("wallpaper")
                pal_mtime = self._safe_mtime(theme.PALETTE_FILE)
                active_wp = theme.detect_active_wallpaper(pal_wp) or pal_wp
                wp_mtime = self._safe_mtime(active_wp)
                cur_accent = cur_pal.get("accent_primary")

                changed = (
                    active_wp != self._theme_wp
                    or wp_mtime != self._theme_wp_mtime
                    or pal_mtime != self._theme_pal_mtime
                    or cur_accent != self._theme_accent
                )
                if changed:
                    dt, colors = theme.sync_topbar_theme_files(
                        active_wp, reload_services=True, fallback_palette=cur_pal
                    )
                    GLib.idle_add(
                        self._apply_theme_colors,
                        colors, active_wp, wp_mtime, pal_mtime, cur_accent
                    )
            except Exception:
                pass
            finally:
                self._theme_checking = False

        threading.Thread(target=worker, daemon=True).start()
        return True

    def _apply_theme_colors(self, colors, active_wp, wp_mtime, pal_mtime, cur_accent):
        if self.is_destroyed:
            return False
        self._theme_wp = active_wp
        self._theme_wp_mtime = wp_mtime
        self._theme_pal_mtime = pal_mtime
        self._theme_accent = cur_accent
        css = self._build_css(colors)
        if self._css_provider is None:
            self._css_provider = Gtk.CssProvider()
            Gtk.StyleContext.add_provider_for_screen(
                self.get_screen(),
                self._css_provider,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )
        self._css_provider.load_from_data(css.encode())
        return False

    def _apply_css(self):
        cur_pal = theme.load_palette()
        pal_wp = cur_pal.get("wallpaper")
        pal_mtime = self._safe_mtime(theme.PALETTE_FILE)
        active_wp = theme.detect_active_wallpaper(pal_wp) or pal_wp
        wp_mtime = self._safe_mtime(active_wp)
        dt, colors = theme.sync_topbar_theme_files(
            active_wp, reload_services=True, fallback_palette=cur_pal
        )
        self._apply_theme_colors(colors, active_wp, wp_mtime, pal_mtime, cur_pal.get("accent_primary"))

