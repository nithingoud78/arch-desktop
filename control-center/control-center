    def _refresh_bluetooth(self):
        def worker():
            try:
                # 1. Controller powered state
                show_out = subprocess.check_output(["bluetoothctl", "show"], stderr=subprocess.DEVNULL, timeout=2).decode()
                powered = ("Powered: yes" in show_out)
                discovering = ("Discovering: yes" in show_out)
                self.bt_discovering = discovering

                if not powered:
                    GLib.idle_add(self._update_bluetooth_ui, False, False, [], [])
                    return

                # 2. Paired devices
                try:
                    paired_out = subprocess.check_output(["bluetoothctl", "devices", "Paired"], stderr=subprocess.DEVNULL, timeout=2).decode()
                except Exception:
                    paired_out = ""
                paired_devs = []
                for line in paired_out.splitlines():
                    if line.startswith("Device "):
                        parts = line.split(" ", 2)
                        mac = parts[1]
                        name = parts[2] if len(parts) > 2 else mac
                        # Check if connected
                        try:
                            info_out = subprocess.check_output(["bluetoothctl", "info", mac], stderr=subprocess.DEVNULL, timeout=1).decode()
                            connected = ("Connected: yes" in info_out)
                        except Exception:
                            connected = False
                        paired_devs.append({"mac": mac, "name": name, "connected": connected})

                # Sort connected first
                paired_devs.sort(key=lambda x: x["connected"], reverse=True)

                # 3. Discovered / available devices
                try:
                    devices_out = subprocess.check_output(["bluetoothctl", "devices"], stderr=subprocess.DEVNULL, timeout=2).decode()
                except Exception:
                    devices_out = ""
                available_devs = []
                paired_macs = {d["mac"] for d in paired_devs}
                for line in devices_out.splitlines():
                    if line.startswith("Device "):
                        parts = line.split(" ", 2)
                        mac = parts[1]
                        name = parts[2] if len(parts) > 2 else mac
                        if mac not in paired_macs and name != mac and not name.replace("-", "").isdigit():
                            available_devs.append({"mac": mac, "name": name})

                GLib.idle_add(self._update_bluetooth_ui, True, discovering, paired_devs, available_devs)
            except Exception:
                GLib.idle_add(self._update_bluetooth_ui, False, False, [], [])

        threading.Thread(target=worker, daemon=True).start()

    def _update_bluetooth_ui(self, powered, discovering, paired_devs, available_devs):
        if getattr(self, "is_destroyed", False):
            return False

        if powered:
            self.lbl_bt_pwr_sub.set_text("Enabled")
            self.btn_bt_power_toggle.set_label("ON")
            self.btn_bt_power_toggle.get_style_context().add_class("active")
            self.bt_off_box.hide()
            self.bt_scroll.show()
            self.btn_bt_scan.set_sensitive(True)
            if discovering:
                self.btn_bt_scan.get_style_context().add_class("active")
            else:
                self.btn_bt_scan.get_style_context().remove_class("active")
        else:
            self.lbl_bt_pwr_sub.set_text("Disabled")
            self.btn_bt_power_toggle.set_label("OFF")
            self.btn_bt_power_toggle.get_style_context().remove_class("active")
            self.bt_off_box.show_all()
            self.bt_scroll.hide()
            self.btn_bt_scan.set_sensitive(False)
            self.btn_bt_scan.get_style_context().remove_class("active")
            return False

        # Clear devices box
        for ch in self.bt_devices_box.get_children():
            self.bt_devices_box.remove(ch)

        # Paired Section
        if paired_devs:
            lbl_p = Gtk.Label(label="MY DEVICES")
            lbl_p.set_name("cc-section-label")
            lbl_p.set_xalign(0)
            self.bt_devices_box.pack_start(lbl_p, False, False, 4)

            for dev in paired_devs:
                row = self._create_bt_paired_row(dev)
                self.bt_devices_box.pack_start(row, False, False, 0)

        # Discovered Section
        lbl_d = Gtk.Label(label="OTHER DEVICES")
        lbl_d.set_name("cc-section-label")
        lbl_d.set_xalign(0)
        self.bt_devices_box.pack_start(lbl_d, False, False, 4)

        if discovering:
            disc_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
            disc_row.set_name("cc-wifi-row")
            lbl_spin = Gtk.Label(label="󰑐  Scanning for nearby devices...")
            lbl_spin.set_name("cc-wifi-sub")
            disc_row.pack_start(lbl_spin, True, True, 0)
            self.bt_devices_box.pack_start(disc_row, False, False, 0)
            
        if available_devs:
            for dev in available_devs:
                row = self._create_bt_available_row(dev)
                self.bt_devices_box.pack_start(row, False, False, 0)
        elif not discovering:
            lbl_none = Gtk.Label(label="No devices found. Tap 󰑐 to scan.")
            lbl_none.set_name("cc-empty-label")
            self.bt_devices_box.pack_start(lbl_none, False, False, 4)
            
        self.bt_devices_box.show_all()
        return False

