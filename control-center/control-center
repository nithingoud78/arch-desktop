        self.wifi_pwd_entry.grab_focus()

    def _hide_wifi_password_box(self):
        self.pending_wifi_ssid = None
        self.wifi_pwd_box.hide()

    def _submit_wifi_password(self):
        ssid = self.pending_wifi_ssid
        pwd = self.wifi_pwd_entry.get_text()
        if not ssid:
            return
        if not pwd:
            self.lbl_wifi_pwd_status.set_text("Please enter a password.")
            return

        self.lbl_wifi_pwd_status.set_text("Connecting...")
        
        def worker():
            success = False
            err_msg = ""
            try:
                # Password securely piped through stdin, never exposed on command line arguments or logs
                p = subprocess.Popen(
                    ["nmcli", "--ask", "dev", "wifi", "connect", ssid],
                    stdin=subprocess.PIPE,
                    stdout=subprocess.PIPE,
                    stderr=subprocess.PIPE,
                    text=True
                )
                stdout, stderr = p.communicate(input=f"{pwd}\n", timeout=15)
                if p.returncode == 0:
                    success = True
                else:
                    err_msg = stderr.strip() if stderr else stdout.strip()
                    if "Secrets were required" in err_msg or "Failed to connect" in err_msg or "802-11-wireless-security" in err_msg:
                        err_msg = "Incorrect Wi-Fi password."
                    elif not err_msg:
                        err_msg = "Connection failed."
            except subprocess.TimeoutExpired:
                err_msg = "Connection timed out."
            except Exception as e:
                err_msg = str(e)

            GLib.idle_add(self._on_wifi_connect_finished, ssid, success, err_msg)

        threading.Thread(target=worker, daemon=True).start()

    def _connect_saved_wifi(self, ssid):
        def worker():
            try:
                subprocess.run(["nmcli", "connection", "up", "id", ssid], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=12)
                time.sleep(0.5)
                GLib.idle_add(lambda: self._refresh_wifi(rescan=False))
                if hasattr(self, "watcher"):
                    self.watcher.trigger()
            except Exception:
                pass
        threading.Thread(target=worker, daemon=True).start()

    def _connect_open_wifi(self, ssid):
        def worker():
            try:
                subprocess.run(["nmcli", "dev", "wifi", "connect", ssid], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=12)
                time.sleep(0.5)
                GLib.idle_add(lambda: self._refresh_wifi(rescan=False))
                if hasattr(self, "watcher"):
                    self.watcher.trigger()
            except Exception:
                pass
        threading.Thread(target=worker, daemon=True).start()

