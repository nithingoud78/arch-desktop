def spring_ease(u, omega=6.2):
    if u <= 0.0:
        return 0.0
    if u >= 1.0:
        return 1.0
    val = 1.0 - math.exp(-omega * u) * (math.cos(omega * u) + (omega / 3.14159) * 0.42 * math.sin(omega * u))
    return max(0.0, min(1.0, val))

PAGE_GAP = 28

class SmoothStack(Gtk.Container):
    """
    Liquid-smooth custom frame-clock-driven multi-page transition container.
    Features:
    - Clean clipping via native GdkWindow
    - Time-based interpolation driven by Wayland vblank tick callback
    - Critically damped harmonic easing curve
    - Bidirectional support across multiple pages with mid-flight reversal
    - Inactive pages hidden at rest for zero resource drain
    """
    def __init__(self, width=302, height=498, duration=0.34):
        super().__init__()
        self.set_has_window(True)
        self.card_width = width
        self.card_height = height
        self.duration = duration
        
        self.pages = {}
        self.current_name = "main"
        self.active_subpage = None
        self.pos = 0.0  # 0.0 = main visible; 1.0 = active_subpage visible
        
        self._animating = False
        self._start_pos = 0.0
        self._target_pos = 0.0
        self._start_time = None
        self._tick_id = None

    def add_named(self, widget, name):
        self.pages[name] = widget
        widget.set_parent(self)
        if name != "main":
            widget.set_child_visible(False)

    def do_realize(self):
        self.set_realized(True)
        alloc = self.get_allocation()
        attr = Gdk.WindowAttr()
        attr.window_type = Gdk.WindowType.CHILD
        attr.x = alloc.x
        attr.y = alloc.y
        attr.width = alloc.width
        attr.height = alloc.height
        attr.wclass = Gdk.WindowWindowClass.INPUT_OUTPUT
        attr.event_mask = self.get_events() | Gdk.EventMask.EXPOSURE_MASK
        visual = self.get_screen().get_rgba_visual()
        attr.visual = visual
        mask = Gdk.WindowAttributesType.X | Gdk.WindowAttributesType.Y | Gdk.WindowAttributesType.VISUAL
        win = Gdk.Window(self.get_parent_window(), attr, mask)
        self.set_window(win)
        win.set_user_data(self)

    def do_remove(self, child):
        for name, widget in list(self.pages.items()):
            if widget == child:
                del self.pages[name]
                child.unparent()
                break

    def do_forall(self, include_internals, callback, *args):
        for child in list(self.pages.values()):
            callback(child, *args)

    def get_visible_child_name(self):
        return self.current_name

    def get_transition_running(self):
        return self._animating

    def do_get_preferred_width(self):
        return self.card_width, self.card_width

    def do_get_preferred_height(self):
        return self.card_height, self.card_height

    def do_size_allocate(self, allocation):
        self.set_allocation(allocation)
        if self.get_realized():
            self.get_window().move_resize(allocation.x, allocation.y, allocation.width, allocation.height)

        w = allocation.width
        h = allocation.height
        stride = w + PAGE_GAP

        if "main" in self.pages:
            main_x = int(round(-self.pos * stride))
            r = Gdk.Rectangle()
            r.x = main_x
            r.y = 0
            r.width = w
            r.height = h
            self.pages["main"].size_allocate(r)

        if self.active_subpage and self.active_subpage in self.pages:
            sub_x = int(round((1.0 - self.pos) * stride))
            r = Gdk.Rectangle()
            r.x = sub_x
            r.y = 0
            r.width = w
            r.height = h
            self.pages[self.active_subpage].size_allocate(r)

        for name, child in self.pages.items():
            if name != "main" and name != self.active_subpage:
                r = Gdk.Rectangle()
                r.x = stride
                r.y = 0
                r.width = w
                r.height = h
                child.size_allocate(r)

    def _update_visibility(self):
        for name, child in self.pages.items():
            if self.pos <= 0.001:
                child.set_child_visible(name == "main")
            elif self.pos >= 0.999:
                child.set_child_visible(name == self.active_subpage)
            else:
                child.set_child_visible(name == "main" or name == self.active_subpage)

    def navigate(self, target_name, instant=False):
        if target_name not in self.pages:
            return
        if not instant and self.current_name == target_name and not self._animating:
            return

        if instant:
            if self._tick_id is not None:
                try:
                    self.remove_tick_callback(self._tick_id)
                except Exception:
                    pass
                self._tick_id = None
            self._animating = False
            self.current_name = target_name
            if target_name == "main":
                self.pos = 0.0
            else:
                self.active_subpage = target_name
                self.pos = 1.0
            self._update_visibility()
            self.queue_allocate()
            return

        if target_name == "main":
            target_pos = 0.0
        else:
            target_pos = 1.0
            self.active_subpage = target_name

        self.current_name = target_name
        self._start_pos = self.pos
        self._target_pos = target_pos
        self._start_time = None
        self._animating = True

        for name, child in self.pages.items():
            child.set_child_visible(name == "main" or name == self.active_subpage)

        if self._tick_id is None:
            self._tick_id = self.add_tick_callback(self._on_tick)

    def _on_tick(self, widget, frame_clock):
        now = time.time()
        if self._start_time is None:
            self._start_time = now
            return True

        elapsed = now - self._start_time
        progress = min(1.0, elapsed / self.duration)
        eased = spring_ease(progress)

        self.pos = self._start_pos + (self._target_pos - self._start_pos) * eased
        self.queue_allocate()

        if progress >= 1.0:
            self.pos = self._target_pos
            self._animating = False
            self._tick_id = None
            self._update_visibility()
            self.queue_allocate()
            return False
        return True


class StateWatcher(threading.Thread):
    """
    Background worker thread completely decoupled from the GTK main loop.
    Periodically polls hardware & network states and notifies GTK via GLib.idle_add.
    Can be immediately triggered on demand via trigger().
    """
    def __init__(self, update_callback):
        super().__init__(daemon=True)
        self.update_callback = update_callback
        self.trigger_event = threading.Event()
        self.running = True
        self.is_cc_open = False

        self.state = {
            "wifi_enabled": False,
            "wifi_ssid": "",
            "wifi_strength": 0,
            "bt_powered": False,
            "hotspot_active": False,
            "airplane_mode": False,
            "media": {
                "status": "Stopped",
                "title": "After Dark",
                "artist": "Mr.Kitty",
                "player": "spotify",
                "art_url": ""
            }
        }

    def set_open(self, is_open):
        self.is_cc_open = is_open
        if is_open:
            self.trigger()

    def trigger(self):
        self.trigger_event.set()

    def run(self):
        # Initial query right after start
        self._query_all()
        GLib.idle_add(self.update_callback, self.state.copy())

        while self.running:
            # Poll every 2.5s if open, or 8.0s if closed
            timeout = 2.5 if self.is_cc_open else 8.0
            self.trigger_event.wait(timeout=timeout)
            self.trigger_event.clear()
            if not self.running:
                break
            self._query_all()
            GLib.idle_add(self.update_callback, self.state.copy())

    def _query_all(self):
        # 1. Wi-Fi status
        try:
            wifi_out = subprocess.check_output(["nmcli", "radio", "wifi"], stderr=subprocess.DEVNULL, timeout=1.5).decode().strip()
            self.state["wifi_enabled"] = (wifi_out == "enabled")
            if self.state["wifi_enabled"]:
                # Active SSID & signal
                dev_out = subprocess.check_output(["nmcli", "-t", "-f", "active,ssid,signal", "dev", "wifi"], stderr=subprocess.DEVNULL, timeout=2.0).decode().strip()
                active_ssid = ""
                active_signal = 0
                for line in dev_out.splitlines():
                    if line.startswith("yes:"):
                        parts = line.split(":")
                        if len(parts) >= 2:
                            active_ssid = parts[1]
                        if len(parts) >= 3 and parts[2].isdigit():
                            active_signal = int(parts[2])
                        break
                self.state["wifi_ssid"] = active_ssid
                self.state["wifi_strength"] = active_signal
            else:
                self.state["wifi_ssid"] = ""
                self.state["wifi_strength"] = 0
        except Exception:
            pass

        # 2. Bluetooth status
        try:
            bt_out = subprocess.check_output(["bluetoothctl", "show"], stderr=subprocess.DEVNULL, timeout=1.5).decode()
            self.state["bt_powered"] = ("Powered: yes" in bt_out)
        except Exception:
            pass

        # 3. Hotspot status
        try:
            conn_out = subprocess.check_output(["nmcli", "-t", "-f", "NAME,TYPE", "connection", "show", "--active"], stderr=subprocess.DEVNULL, timeout=1.5).decode()
            hotspot_on = False
            for line in conn_out.splitlines():
                if ":wifi" in line and "hotspot" in line.lower():
                    hotspot_on = True
                    break
            self.state["hotspot_active"] = hotspot_on
        except Exception:
            pass

        # 4. Airplane status
        try:
            rf_out = subprocess.check_output(["rfkill", "list"], stderr=subprocess.DEVNULL, timeout=1.0).decode().lower()
            lines = rf_out.splitlines()
            blocked_count = sum(1 for line in lines if "soft blocked: yes" in line)
            total_count = sum(1 for line in lines if "soft blocked:" in line)
            self.state["airplane_mode"] = (blocked_count > 0 and blocked_count >= total_count - 1)
        except Exception:
            pass

        # 5. Media player
        try:
            st = subprocess.check_output(["playerctl", "-p", "spotify,firefox,brave,chromium,%any", "status"], stderr=subprocess.DEVNULL, timeout=0.8).decode().strip()
            if st in ("Playing", "Paused"):
                title = subprocess.check_output(["playerctl", "metadata", "title"], stderr=subprocess.DEVNULL, timeout=0.5).decode().strip()
                artist = subprocess.check_output(["playerctl", "metadata", "artist"], stderr=subprocess.DEVNULL, timeout=0.5).decode().strip()
                try:
                    art_url = subprocess.check_output(["playerctl", "metadata", "mpris:artUrl"], stderr=subprocess.DEVNULL, timeout=0.5).decode().strip()
                except Exception:
                    art_url = ""
                self.state["media"] = {
                    "status": st,
                    "title": title if title else "After Dark",
                    "artist": artist if artist else "Mr.Kitty",
                    "player": "spotify",
                    "art_url": art_url
                }
            else:
                self.state["media"]["status"] = "Stopped"
        except Exception:
            pass


class ControlCenter(Gtk.Window):
    def __init__(self, daemon=None, initial_page="main", show_power=False):
        super().__init__(type=Gtk.WindowType.TOPLEVEL)
        self.daemon = daemon
        
        # Ensure RGBA visual for transparency
        screen = self.get_screen()
        visual = screen.get_rgba_visual()
        if visual:
            self.set_visual(visual)
        
        # Layer Shell setup
        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "control-center")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.TOP, True)
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.RIGHT, True)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, 52)
        GtkLayerShell.set_margin(self, GtkLayerShell.Edge.RIGHT, 16)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)
        
        self.set_app_paintable(True)
        self.set_decorated(False)
        self.connect("key-press-event", self._on_key_press)
        
        # State
        self.initial_page = initial_page
        self.show_power = show_power
        self.brightness_val = self._get_brightness()
        self.volume_val = self._get_volume()
        self.pending_power_action = None
        self.pending_wifi_ssid = None
        self.wifi_scanning = False
        self.bt_discovering = False
        
        # Debounce timers for sliders
        self._bright_debounce_timer = None
        self._vol_debounce_timer = None
        
        self.is_open = False
        self.is_closing = False
        self.ready_for_dismissal = False
        self.has_had_focus = False
        self._tick_id = None
        self.is_destroyed = False
        
        # Build UI & Apply CSS
        self._css_provider = None
        self._theme_checking = False
        self._theme_wp = None
        self._theme_wp_mtime = 0
        self._theme_pal_mtime = 0
        self._theme_accent = None
        self._setup_ui(initial_page)
        self._apply_css()
        
        # StateWatcher background worker
        self.watcher = StateWatcher(self._on_state_watcher_update)
        self.watcher.start()
        
        # Clock updates (every second on GTK main loop is negligible: pure string format)
        GLib.timeout_add(1000, self._update_clock)
        
        # Dock size sync
        GLib.timeout_add(4000, self._sync_dock_size)

        # Live wallpaper theme polling for Waybar & Control Center
        GLib.timeout_add(1200, self._poll_theme)
        
        # Dismissal & IPC
        self.connect("focus-in-event", self._on_focus_in)
        self.connect("focus-out-event", self._on_focus_out)
        self._start_hyprland_listener()

    def _get_brightness(self):
        # Instant sysfs read: 0.02ms vs 10ms for brightnessctl
        sysfs_path = "/sys/class/backlight/nvidia_wmi_ec_backlight"
        if os.path.exists(sysfs_path):
            try:
                with open(f"{sysfs_path}/brightness") as f:
                    b = int(f.read().strip())
                with open(f"{sysfs_path}/max_brightness") as f:
                    m = int(f.read().strip())
                if m > 0:
                    return max(0, min(100, round((b / m) * 100)))
            except Exception:
                pass
        try:
            out = subprocess.check_output(["brightnessctl", "g"], stderr=subprocess.DEVNULL).decode().strip()
            mout = subprocess.check_output(["brightnessctl", "m"], stderr=subprocess.DEVNULL).decode().strip()
            cur = int(out)
            mx = int(mout)
            return round((cur / mx) * 100) if mx > 0 else 68
        except Exception:
            return 68

    def _get_volume(self):
        try:
            out = subprocess.check_output(["wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@"], stderr=subprocess.DEVNULL).decode().strip()
            for part in out.split():
                try:
                    val = float(part)
                    return round(val * 100)
                except ValueError:
                    pass
        except Exception:
            pass
        return 42

    def _on_focus_in(self, widget, event):
        self.has_had_focus = True
        return False

    def _on_focus_out(self, widget, event):
        return False

    def _bind_mouse(self):
        self._unbind_mouse()
        pid = os.getpid()
        lua = (
            f"hl.bind('mouse:272', hl.dsp.exec_cmd('kill -USR1 {pid}'), {{ non_consuming = true }}); "
            f"hl.bind('mouse:273', hl.dsp.exec_cmd('kill -USR1 {pid}'), {{ non_consuming = true }}); "
            f"hl.bind('Escape', hl.dsp.exec_cmd('kill -USR2 {pid}'))"
        )
        subprocess.run(["hyprctl", "eval", lua], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def _unbind_mouse(self):
        lua = "pcall(hl.unbind, 'mouse:272'); pcall(hl.unbind, 'mouse:273'); pcall(hl.unbind, 'Escape')"
        subprocess.run(["hyprctl", "eval", lua], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def _handle_escape(self):
        if hasattr(self, "stack") and self.stack.get_visible_child_name() in ("wifi", "bluetooth", "hotspot", "settings"):
            self._navigate_to("main")
            return
        if hasattr(self, "daemon") and self.daemon:
            self.daemon.set_target_state("closed")
        self._close_with_animation()

    def _is_in_dock_toggle(self, cx, cy):
        rect_path = f"/run/user/{os.getuid()}/cc-toggle.rect"
        try:
            with open(rect_path, "r") as f:
                raw = f.read().strip()
            if not raw:
                return False
            x1, y1, x2, y2 = [int(v) for v in raw.split(",")]
            return (x1 - 3) <= cx <= (x2 + 3) and (y1 - 3) <= cy <= (y2 + 3)
        except Exception:
            return False

    def _check_outside_click(self):
        if not getattr(self, "ready_for_dismissal", False) or getattr(self, "is_closing", False):
            return
        try:
            pos = subprocess.check_output(["hyprctl", "cursorpos"], stderr=subprocess.DEVNULL).decode().strip()
            parts = [int(v.strip()) for v in pos.split(",")]
            cx, cy = parts[0], parts[1]
        except Exception:
            return

        alloc = self.get_allocation()
        screen = Gdk.Screen.get_default()
        sw = screen.get_width() if screen else 1600

        x_min = sw - 16 - alloc.width
        x_max = sw - 16
        y_min = 52
        y_max = 52 + alloc.height

        # Toggle button on the bottom dock (skip press so button-release toggles cleanly)
        if self._is_in_dock_toggle(cx, cy):
            return

        # Inside Control Center card: leave open
        if x_min <= cx <= x_max and y_min <= cy <= y_max:
            return

        # Outside click: dismiss
        if hasattr(self, "daemon") and self.daemon:
            self.daemon.set_target_state("closed")
        set_arrow_state("closed")
        self._close_with_animation()

    def _start_hyprland_listener(self):
        sig = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
        if not sig:
            return
        sock_path = f"/run/user/{os.getuid()}/hypr/{sig}/.socket2.sock"
        if not os.path.exists(sock_path):
            return

        def listen():
            try:
                s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                s.connect(sock_path)
                s.settimeout(1.0)
                time.sleep(0.25)
                while not getattr(self, "is_destroyed", False):
                    try:
                        data = s.recv(1024)
                        if not data:
                            break
                        text = data.decode("utf-8", errors="ignore")
                        for line in text.splitlines():
                            line = line.strip()
                            if not line:
                                continue
                            if any(line.startswith(p) for p in [
                                "workspace>>",
                                "workspacev2>>",
                                "focusedmon>>",
                            ]):
                                if getattr(self, "is_open", False) and getattr(self, "ready_for_dismissal", False):
                                    if hasattr(self, "daemon") and self.daemon:
                                        self.daemon.set_target_state("closed")
                                    GLib.idle_add(self._close_with_animation)
                    except socket.timeout:
                        continue
                    except Exception:
                        break
                s.close()
            except Exception:
                pass

        threading.Thread(target=listen, daemon=True).start()

    def animate_in(self, page=None, show_power=None):
        if self._tick_id is not None:
            try:
                self.remove_tick_callback(self._tick_id)
            except Exception:
                pass
            self._tick_id = None

        self.is_closing = False
        self.is_open = True
        self.ready_for_dismissal = False
        if hasattr(self, "daemon") and self.daemon:
            self.daemon.set_target_state("open")
        set_arrow_state("open")

        # Wake up background watcher immediately
        if hasattr(self, "watcher"):
            self.watcher.set_open(True)

        self._update_clock()

        if page and hasattr(self, "stack"):
            if getattr(self, "is_open", False):
                self._navigate_to(page)
            else:
                self.stack.navigate(page, instant=True)
        elif getattr(self, "initial_page", None):
            self.stack.navigate(self.initial_page, instant=True)

        if show_power is not None and hasattr(self, "power_revealer"):
            if show_power:
                self.power_revealer.show_all()
                if hasattr(self, "power_card"):
                    self.power_card.show_all()
            self.power_revealer.set_reveal_child(show_power)
        elif hasattr(self, "power_revealer"):
            sp = getattr(self, "show_power", False)
            if sp:
                self.power_revealer.show_all()
                if hasattr(self, "power_card"):
                    self.power_card.show_all()
            self.power_revealer.set_reveal_child(sp)

        start_margin = GtkLayerShell.get_margin(self, GtkLayerShell.Edge.TOP)
        if start_margin < 38 or start_margin > 52:
            start_margin = 38
        target_margin = 52
        start_opacity = self.get_opacity()
        if start_opacity >= 0.99 and start_margin == 52 and self.get_visible():
            self.ready_for_dismissal = True
            self._bind_mouse()
            return

        duration = 0.20
        start_time = None

        self.set_opacity(start_opacity)
        self.outer_box.show()
        self.main_card.show_all()
        self.show()

        def on_open_tick(widget, frame_clock):
            nonlocal start_time
            now = time.time()
            if start_time is None:
                start_time = now
                return True
            elapsed = now - start_time
            progress = min(1.0, elapsed / duration)
            ease = 1.0 - math.pow(1.0 - progress, 3)

            curr_margin = int(start_margin + (target_margin - start_margin) * ease)
            GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, curr_margin)
            self.set_opacity(start_opacity + (1.0 - start_opacity) * ease)

            if progress >= 1.0:
                self._tick_id = None
                GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, 52)
                self.set_opacity(1.0)
                self.ready_for_dismissal = True
                self._bind_mouse()
                return False
            return True

        self._tick_id = self.add_tick_callback(on_open_tick)

        def force_finish_open():
            if getattr(self, "is_open", False) and not getattr(self, "is_closing", False) and not getattr(self, "ready_for_dismissal", False):
                if self._tick_id is not None:
                    try:
                        self.remove_tick_callback(self._tick_id)
                    except Exception:
                        pass
                    self._tick_id = None
                GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, 52)
                self.set_opacity(1.0)
                self.ready_for_dismissal = True
                self._bind_mouse()
            return False

        GLib.timeout_add(int((duration + 0.08) * 1000), force_finish_open)

    def _close_with_animation(self):
        if not self.is_open and not self.get_visible():
            return
        if self.is_closing:
            return

        if self._tick_id is not None:
            try:
                self.remove_tick_callback(self._tick_id)
            except Exception:
                pass
            self._tick_id = None

        self.is_closing = True
        self.is_open = False
        self.ready_for_dismissal = False
        self._unbind_mouse()
        if hasattr(self, "daemon") and self.daemon:
            self.daemon.set_target_state("closed")
        set_arrow_state("closed")

        if hasattr(self, "watcher"):
            self.watcher.set_open(False)

        start_margin = GtkLayerShell.get_margin(self, GtkLayerShell.Edge.TOP)
        target_margin = 38
        start_opacity = self.get_opacity()

        duration = 0.16
        start_time = None

        def on_close_tick(widget, frame_clock):
            nonlocal start_time
            now = time.time()
            if start_time is None:
                start_time = now
                return True
            elapsed = now - start_time
            progress = min(1.0, elapsed / duration)
            ease = math.pow(progress, 2)

            curr_margin = int(start_margin + (target_margin - start_margin) * ease)
            GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, curr_margin)
            self.set_opacity(max(0.0, start_opacity * (1.0 - ease)))

            if progress >= 1.0:
                self._tick_id = None
                self.hide()
                self.set_opacity(1.0)
                GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, 52)
                self.is_closing = False
                return False
            return True

        self._tick_id = self.add_tick_callback(on_close_tick)

        def force_finish_close():
            if getattr(self, "is_closing", False):
                if self._tick_id is not None:
                    try:
                        self.remove_tick_callback(self._tick_id)
                    except Exception:
                        pass
                    self._tick_id = None
                self.hide()
                self.set_opacity(1.0)
                GtkLayerShell.set_margin(self, GtkLayerShell.Edge.TOP, 52)
                self.is_closing = False
            return False

        GLib.timeout_add(int((duration + 0.08) * 1000), force_finish_close)

