#!/usr/bin/env bash
set -u

export PATH="$HOME/.local/bin:$PATH"

mkdir -p "$HOME/Pictures/Screenshots"
out="$HOME/Pictures/Screenshots/$(date +%F_%H-%M-%S)-$$.png"

if grim "$out"; then
    wl-copy --type image/png < "$out"
    if command -v notify-send >/dev/null 2>&1; then
        notify-send "Screenshot captured" "Saved and copied to clipboard."
    fi
    exit 0
else
    rm -f "$out"
    exit 1
fi
